# Local credentials and private material
.env
.env.*
!.env.example
!.env.template
.aws/
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
data/private/
data/raw/
# Workbench imports remain local; only the folder's instructions are shared.
data/local-videos/*
!data/local-videos/README.md

# Local tools and caches
.codex/
.claude/settings.local.json
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
.playwright-cli/
output/playwright/
.DS_Store
Thumbs.db
Desktop.ini
~$*

# Generated previews and temporary output
**/qa/
**/qa-integrated/
artifacts/
tmp/
data/local-workbench/**
!data/local-workbench/README.md
*.log
cdk.out/
dist/
build/

# Local source videos stay ignored; selected shared clips use Git LFS.
*.mp4
*.mov
*.mkv
*.webm
*.avi
!data/videos/**/*.mp4
!data/videos/**/*.mov
!data/videos/**/*.mkv
!data/videos/**/*.webm
!data/videos/**/*.avi
