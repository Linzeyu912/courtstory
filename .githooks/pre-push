#!/bin/sh
identity_root=$(git rev-parse --show-toplevel) || exit 1
. "$identity_root/.githooks/identity-policy.sh" || exit 1
check_current_identity || exit 1

push_updates=$(cat)
printf '%s\n' "$push_updates" | while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    # Non-commit tags contain no author/committer records to validate.
    git rev-parse --verify "${local_oid}^{commit}" >/dev/null 2>&1 || continue
    check_revision_identity "$local_oid" || exit 1
done || exit 1
printf '%s\n' "$push_updates" | git lfs pre-push "$@"
