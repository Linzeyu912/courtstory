              "type": [
                "boolean",
                "null"
              ]
            },
            "intervals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
