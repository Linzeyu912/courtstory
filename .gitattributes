* text=auto
*.md text eol=lf
*.json text eol=lf
"2K Player Data/**/*.jsonl" text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.docx binary
*.pdf binary
*.png binary
*.jpg binary

# Shared video assets: metadata remains ordinary Git text.
data/videos/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
data/videos/**/*.mov filter=lfs diff=lfs merge=lfs -text
data/videos/**/*.mkv filter=lfs diff=lfs merge=lfs -text
data/videos/**/*.webm filter=lfs diff=lfs merge=lfs -text
data/videos/**/*.avi filter=lfs diff=lfs merge=lfs -text
