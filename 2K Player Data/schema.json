  "null_semantics": "Unknown or unavailable, never 0; no imputation, no cross-edition substitution.",
  "reference_resolution": {
    "source_id": "sources.json.catalog[source_id]",
    "text_id": "sources.json.shared_texts[text_id]; null means original text was empty",
    "record_id": "index.json.by_record[record_id]",
    "player_id": "index.json.players[player_id]"
  },
  "identity_assumptions": "保留原player_key；新增球员仍用规范化精确姓名键；新显式别名需有approved_expansion_sources.json证据。BBR编号未取得者仍为null。",
  "chronology": "Record order and team order are not transaction chronology. Only transaction_date_as_listed conveys a source-listed date.",
  "snapshot_time": "Per-field historical sources for NBA 2K25/2K26, including explicitly dated older 2K25 null fills; fixed commit dates are not game patch dates. Existing non-null values and their source definitions remain unchanged. Mixed records are not a uniform final-season snapshot.",
  "field_provenance_contract": {
    "path": "field_provenance.json",
    "record_fields": {
      "default_source_id": "string: original baseline source",
      "baseline_fields": "array<string>: metrics whose original non-null values remain",
      "field_source_ids": "object<string,string>: supplemental metric -> source_id",
      "supplement_matches": "object<source_id,object{source_player_name:string,source_slug:string|null,match_method:normalized_exact|explicit_alias}>"
    },
    "source_fields": {
      "source_url": "string",
      "game": "NBA 2K25|NBA 2K26",
      "snapshot_date": "ISO8601 string|null",
      "date_basis": "string; capture vs repository sync/commit explicitly distinguished",
      "game_patch_date": "null: unknown",
      "source_commit_date": "ISO8601 string|null",
      "per_player_capture_known": "boolean",
      "source_kind": "preserved_baseline|verified_archived_html|fixed_blacktop_current_roster|fixed_historical_2k25_csv|verified_archive_gap_html"
    },
    "resolution_rule": "For a non-null metric: use records[record_id].field_source_ids[field] if present, otherwise default_source_id only when field is listed in baseline_fields. Null metrics have no value source."
  },
  "derived_display_fields": "Upstream human-readable combined team/jersey strings and missing-label strings are replaced by structured stints and missing-key lists; original underlying values and labels are retained.",
  "scope": "两季各30支NBA球队的整个赛季名单（包括季内离队球员）；交易only关联单独标记，不计球队能力表。"
