{
  "schema_version": "1.0.0",
  "format": "explicit-field-contract",
  "encoding": "UTF-8 without BOM; JSONL has one object per LF-terminated line",
  "record_types": {
    "player_season": {
      "files": [
        "players/2024-25.jsonl",
        "players/2025-26.jsonl"
      ],
      "fields": {
        "record_id": "string: player_id + '@' + season",
        "player_id": "string: unchanged upstream player_key",
        "player_name": "string: source roster name, no invented translation",
        "season": "enum: 2024-25, 2025-26",
        "game": "enum: NBA 2K25, NBA 2K26",
        "qualifying_playoff_teams": "array<object{team_abbreviation:string,team_name:string,team_name_zh:string,source_id:string}>; derived from qualifying roster associations, not snapshot",
        "ratings": "object with all 42 exact keys listed in rating_fields; every value integer 25..99 or null",
        "availability": "object{status:complete|partial|missing_record,missing_keys:array<string>,missing_individual_keys:array<string>,individual_present:integer,individual_expected:integer,core_present:integer}; completeness refers to 36 individual fields",
        "season_teams": "array<stint>; contains same-season roster and separately tagged official transaction associations; association does not imply game appearance",
        "snapshot": "object{source_player_name:string|null,team:string|null,jersey:string|null,jersey_raw:string|null,source_id:string,basis_text_id:string,quality_note_text_id:string|null,exact_capture_date:null,exact_game_patch_date:null}",
        "identity": "object{upstream_player_key:string,bbr_player_id:string|null,join_method:normalized_exact|audited_alias|unmatched}",
        "provenance": "object{rating_source_id:string,rating_origin_source_id:string,rating_source_commit:string,rating_source_retrieved_date:YYYY-MM-DD,roster_source_ids:array<string>,roster_source_retrieved_date:YYYY-MM-DD}"
      }
    },
    "history": {
      "file": "team_history.jsonl",
      "fields": {
        "player_id": "string",
        "player_name": "string",
        "stints": "array<stint>, both seasons including non-playoff teams",
        "distinct_teams_in_two_seasons": "integer",
        "has_multiple_teams_within_season": "boolean; includes explicitly marked transaction associations",
        "note_text_id": "string",
        "source_ids": "array<string>"
      }
    },
    "stint": {
      "fields": {
        "season": "enum: 2024-25, 2025-26",
        "team_abbreviation": "string",
        "team_name": "string",
        "team_name_zh": "string",
        "jersey": "string|null; raw source text, e.g. '0', '00', '00, 0'; never numeric",
        "jersey_numbers": "array<string>; comma-split, whitespace-trimmed derivative of jersey; [] for null; no temporal order inferred",
        "team_qualified_playoffs": "boolean",
        "in_rating_scope": "boolean; player's season-selection flag, not team's classification",
        "phase": "string: preserved source phase, includes season roster, regular season, 2025 offseason",
        "association_kind": "string: season_team_roster or official_transaction_without_matching_season_roster_row",
        "transaction_date_as_listed": "YYYY-MM-DD string|null; date listed in NBA tracker, not inferred arrival/departure",
        "record_type_text_id": "string",
        "note_text_id": "string",
        "source_id": "string",
        "source_retrieved_date": "YYYY-MM-DD string"
      }
    }
  },
