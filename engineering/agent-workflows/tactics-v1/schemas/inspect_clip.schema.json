{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inspect_clip.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "args": {
      "type": "object",
      "properties": {
        "assetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "baseDocumentRef": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 0
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "storeRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                }
              },
              "required": [
                "documentId",
                "version",
                "digest",
                "storeRef"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceFrames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "assetRef"
      ],
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "expectedRunRevision": {
      "type": "integer",
      "minimum": 0
    },
    "range": {
      "type": "object",
      "properties": {
        "startFrame": {
          "type": "integer",
          "minimum": 0
        },
        "endFrameExclusive": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "startFrame",
        "endFrameExclusive"
      ],
      "additionalProperties": false
    },
    "policyRef": {
      "const": "tactics-default-v1"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "args",
    "idempotencyKey",
    "runId",
    "expectedRunRevision",
    "range",
    "policyRef"
  ],
  "additionalProperties": false
}
