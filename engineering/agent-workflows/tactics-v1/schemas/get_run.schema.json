{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_run.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "args": {
      "type": "object",
      "properties": {
        "afterRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "args",
    "runId"
  ],
  "additionalProperties": false
}
